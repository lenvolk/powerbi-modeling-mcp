<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerBiMcpServer</RootNamespace>
    <AssemblyName>powerbi-mcp-server</AssemblyName>
  </PropertyGroup>

  <!-- Kill any running instance before build to prevent file-lock errors during rebuild -->
  <Target Name="KillExistingProcess" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq powerbi-mcp-server.exe&quot; /NH 2>nul | findstr /i &quot;powerbi-mcp-server&quot; >nul &amp;&amp; (taskkill /IM powerbi-mcp-server.exe /F >nul 2>&amp;1 &amp; ping -n 3 127.0.0.1 >nul 2>&amp;1) || exit /b 0"
          IgnoreExitCode="true" StandardErrorImportance="low" StandardOutputImportance="low" />
  </Target>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.2.0-preview.2" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
  </ItemGroup>

</Project>
